# ─────────────────────────────────────────────────────────────
# SkyBot v2 Dashboard — Environment Variables (Vercel)
# ─────────────────────────────────────────────────────────────
# Set these in Vercel → your dashboard project → Settings → Environment Variables

# ── REQUIRED (for production) ─────────────────────────────────
# The URL of your bot's HTTP API running on Railway
# Find this in Railway → your bot service → Settings → Networking → Public URL
# Example: https://skybot-bot.up.railway.app
NEXT_PUBLIC_BOT_API_URL=https://your-bot-name.up.railway.app

# ── OPTIONAL ──────────────────────────────────────────────────
# If you set DASHBOARD_TOKEN on the bot, set the same value here
# The dashboard will send it as a Bearer token with every API request
# NEXT_PUBLIC_DASHBOARD_TOKEN=your_shared_secret_token
