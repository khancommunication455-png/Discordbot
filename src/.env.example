# ─────────────────────────────────────────────────────────────
# SkyBot v2 — Environment Variables (Railway)
# ─────────────────────────────────────────────────────────────
# Copy these to Railway → Variables tab.

# ── REQUIRED ──────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_application_id_here
HYPIXEL_API_KEY=your_hypixel_api_key_here

# ── AI / TTS ──────────────────────────────────────────────────
# Groq powers the AI voice assistant + AH chatbot (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ── AH Flip Tracker ───────────────────────────────────────────
# Channel where flip alerts are posted
AH_FLIP_CHANNEL_ID=
# Role pinged on high-profit flips (leave blank to disable ping)
PREMIUM_ROLE_ID=
# Minimum profit (coins) to trigger an alert (default: 100000)
AH_FLIP_MIN_PROFIT=100000
# Minimum margin (%) — item must be this % below median (default: 5)
AH_FLIP_MIN_MARGIN=5
# How many AH pages to scan per cycle (max 10, default: 10)
AH_FLIP_MAX_PAGES=10
# Seconds between scans (min 20 to respect Hypixel rate limits, default: 30)
AH_FLIP_INTERVAL=30
# Maximum flips to post per scan cycle (anti-spam, default: 5)
AH_FLIP_MAX_PER_CYCLE=5

# ── Auction Sold Watcher ──────────────────────────────────────
AUCTION_SOLD_CHANNEL_ID=

# ── AH ChatBot ────────────────────────────────────────────────
AH_CHATBOT_CHANNEL_ID=

# ── Web Dashboard ─────────────────────────────────────────────
# Port Railway will expose (Railway sets PORT automatically; this is fallback)
PORT=8080
# Secret token for dashboard API auth (set to random string)
DASHBOARD_TOKEN=change_me_to_random_string
# CORS: comma-separated list of dashboard URLs allowed to call this API
# Leave blank to allow ALL origins (fine for dev, tighten for production)
# Example: https://skybot-dashboard.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=

# ── Optional Integrations ─────────────────────────────────────
REMOVE_BG_API_KEY=
LOG_CHANNEL_ID=
CARRY_CHANNEL_ID=
GUILD_ID=your_test_server_id_for_instant_command_registration

# ── Music / Download ──────────────────────────────────────────
# yt-dlp is auto-installed by nixpacks.toml
# No env var needed — the bot auto-detects the binary
